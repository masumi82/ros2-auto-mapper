<?xml version="1.0"?>
<sdf version="1.6">
  <world name="object_house">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 明るい照明が必須: 暗いとYOLOの認識が全滅する(静止認識テストの実測) -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.8 0.8 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <model name="turtlebot3_house">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_house</uri>
      </include>
    </model>

    <!-- 封鎖壁(前回プロジェクトの計測値。屋外流出防止) -->
    <model name="front_door_plug">
      <static>true</static>
      <pose>0.94 -0.08 0.5 0 0 0</pose>
      <link name="plug">
        <collision name="c"><geometry><box><size>1.1 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.1 0.3 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="side_gap_plug">
      <static>true</static>
      <pose>4.51 -0.08 0.5 0 0 0</pose>
      <link name="plug">
        <collision name="c"><geometry><box><size>1.1 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.1 0.3 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 探索対象の物体(正解表: docs/object_patrol_result.md) ===== -->
    <model name="target_person_standing_1">
      <static>true</static>
      <pose>-4.9 4.3 0 0 0 -1.3</pose>
      <include><uri>model://person_standing</uri></include>
    </model>
    <model name="target_person_walking_1">
      <static>true</static>
      <pose>6.2 0.2 0 0 0 2.4</pose>
      <include><uri>model://person_walking</uri></include>
    </model>
    <model name="target_fire_hydrant_1">
      <static>true</static>
      <pose>-6.3 1.5 0 0 0 0</pose>
      <include><uri>model://fire_hydrant</uri></include>
    </model>
    <model name="target_stop_light_1">
      <static>true</static>
      <pose>-0.5 3.9 0 0 0 -1.57</pose>
      <include><uri>model://stop_light</uri></include>
    </model>
    <model name="target_ball_1">
      <static>true</static>
      <pose>-2.2 4.35 0 0 0 0</pose>
      <include><uri>model://robocup_spl_ball</uri></include>
    </model>
    <model name="target_person_standing_2">
      <static>true</static>
      <pose>3.3 2.6 0 0 0 -2.0</pose>
      <include><uri>model://person_standing</uri></include>
    </model>
    <model name="target_fire_hydrant_2">
      <static>true</static>
      <pose>5.5 -1.3 0 0 0 0</pose>
      <include><uri>model://fire_hydrant</uri></include>
    </model>

  </world>
</sdf>
