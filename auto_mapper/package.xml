<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auto_mapper</name>
  <version>1.0.0</version>
  <description>Fully autonomous indoor mapping: frontier exploration + LiDAR-ray fallback + wander mode on ROS 2 / Nav2 / slam_toolbox</description>
  <maintainer email="mylifestyle.mh9482@gmail.com">masumi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>slam_toolbox</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
